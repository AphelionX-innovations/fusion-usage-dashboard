# Lancer : docker compose --env-file .env.docker up -d
# Le port hôte est choisi automatiquement. Le voir avec : docker compose port web 80

# Variables du front, injectées au démarrage du conteneur (sans rebuild).
# Chemin relatif = le navigateur reste sur la même origine, nginx proxifie.
# URL absolue = le navigateur appelle l'API directement (le serveur doit autoriser CORS).
VITE_AUTH_API_URL=/auth-api
VITE_FUSION_API_URL=/fusion-api

# Cibles du proxy nginx quand les variables du front sont relatives.
AUTH_API_PROXY=https://stg-login.abafusion.ai
FUSION_API_PROXY=https://stg-perf.abafusion.ai
